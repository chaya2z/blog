{
  "name": "blog",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "fonts": "astro build && node scripts/subset-fonts.ts",
    "fonts:check": "node scripts/subset-fonts.ts --check",
    "og": "node og/render.ts",
    "og:dev": "cd og && astro dev",
    "preview": "astro preview",
    "astro": "astro",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "typecheck": "astro check && astro check --root og",
    "test": "vitest run"
  },
  "dependencies": {
    "@astrojs/markdown-satteri": "^0.4.5",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "astro": "^7.4.7",
    "katex": "^0.19.1",
    "satteri": "^0.10.5",
    "sharp": "^0.35.5",
    "ultrahtml": "^1.7.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@astrojs/compiler-rs": "^0.5.2",
    "budoux": "^0.10.1",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "playwright": "1.64.1",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5",
    "wrangler": "^4.152.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^12.10.1",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=26"
  }
}
