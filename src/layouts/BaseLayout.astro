---
import { Font } from 'astro:assets';
import '@/styles/global.css';
import type { Lang } from '@/utils/languages';
import { SITE_TITLE } from '@/site';

interface Props {
  title: string;
  lang: Lang;
}

const { title, lang } = Astro.props;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <link
      rel="alternate"
      type="application/rss+xml"
      title={SITE_TITLE}
      href={new URL('rss.xml', Astro.site)}
    />
    <Font cssVariable="--font-inter" />
    <Font cssVariable="--font-noto-sans-jp" />
    {/* What a layout or page adds to its own head, such as its metadata. */}
    <slot name="head" />
  </head>
  <body>
    <slot />
  </body>
</html>
