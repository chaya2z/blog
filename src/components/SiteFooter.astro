---
import ArrowOutwardIcon from '@/assets/icons/arrow-outward.svg';
import { AUTHOR } from '@/site';

// The site's own pages, then the author's elsewhere.
const COLUMNS = [
  {
    id: 'footer-site',
    heading: 'Site',
    links: [
      { href: '/posts/', label: 'Posts' },
      { href: '/about/', label: 'About' },
      { href: '/rss.xml', label: 'RSS' },
    ],
  },
  {
    id: 'footer-author',
    heading: 'Author',
    external: true,
    links: [
      { href: AUTHOR.links.github, label: 'GitHub' },
      { href: AUTHOR.links.linkedin, label: 'LinkedIn' },
      { href: AUTHOR.links.website, label: 'chaya2z.com' },
    ],
  },
];

const COPYRIGHT_FIRST_YEAR = 2019;
const BUILD_YEAR = new Date().getUTCFullYear();
const COPYRIGHT_YEARS =
  COPYRIGHT_FIRST_YEAR === BUILD_YEAR
    ? `${COPYRIGHT_FIRST_YEAR}`
    : `${COPYRIGHT_FIRST_YEAR}–${BUILD_YEAR}`;
---

{/* UI text is English, even on a Japanese page. */}
<footer lang="en">
  <div class="container">
    <div class="top">
      {/* Heavy and hairline, the second name stepped one column in. */}
      <p class="name">
        Abyssal <span class="last">Tarantella</span>
      </p>
      <nav aria-label="Footer">
        {COLUMNS.map((column) => (
          <div>
            <p class="heading" id={column.id}>
              {column.heading}
            </p>
            <ul aria-labelledby={column.id}>
              {column.links.map((link) => (
                <li>
                  <a href={link.href}>
                    {link.label}
                    {column.external && (
                      <ArrowOutwardIcon class="arrow" fill="currentColor" aria-hidden="true" />
                    )}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </nav>
    </div>
    {/* The fine print sits below a hairline, all at the same quiet size. */}
    <div class="legal">
      <p>&copy; {COPYRIGHT_YEARS} chaya2z</p>
      <a href="/privacy/">Privacy</a>
    </div>
  </div>
</footer>

<style>
  /* The page closes on a solid, mirroring the header. */
  footer {
    padding-block: clamp(3rem, 6vw, 4.5rem);
    color: var(--on-solid-muted);
    background: var(--solid);
    border-top: var(--rule-heavy) solid var(--accent);
  }
  .top {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-end;
    gap: 2.5rem 2rem;
  }
  .name {
    margin: 0;
    color: var(--on-solid);
    font-size: clamp(2.5rem, 7vw, 5.5rem);
    font-weight: 860;
    line-height: 0.9;
    letter-spacing: -0.06em;
    text-transform: uppercase;
  }
  .last {
    display: block;
    margin-left: calc(100cqi / 12);
    font-weight: 250;
  }
  nav {
    display: flex;
    flex-wrap: wrap;
    gap: 2rem clamp(2rem, 5vw, 4rem);
  }
  .heading {
    margin: 0 0 0.5rem;
    font-size: 0.8rem;
    font-weight: 750;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  ul {
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 0.95rem;
    font-weight: 750;
  }
  ul a {
    display: inline-block;
    padding-block: 0.375rem;
    color: var(--on-solid);
    text-decoration: none;
  }
  /* Marks the links that leave the site. */
  .arrow {
    width: 1em;
    height: 1em;
    margin-left: 0.1em;
    vertical-align: -0.125em;
  }
  /*
   * Pointing at a link, or focusing it, sets the other links back in the muted
   * ink, so the one in hand stands alone. They fade rather than blink, unless
   * motion is reduced.
   */
  nav:has(a:hover, a:focus-visible) a:not(:hover, :focus-visible) {
    color: var(--on-solid-muted);
  }
  @media (prefers-reduced-motion: no-preference) {
    ul a {
      transition: color 0.2s ease-out;
    }
  }
  .legal {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.5rem;
    margin-top: clamp(2.5rem, 5vw, 3.5rem);
    padding-top: 1rem;
    border-top: 1px solid var(--on-solid-muted);
    font-size: 0.9rem;
  }
  .legal p {
    margin: 0;
  }
  .legal a:hover {
    color: var(--on-solid);
  }
</style>
