---
interface Props {
  title: string;
  /** Language of the post title; the rest of the trail is English UI. */
  lang: string;
}

const { title, lang } = Astro.props;
---

<nav aria-label="Breadcrumb" lang="en">
  <ol>
    <li><a href="/">Home</a></li>
    <li><a href="/posts/">Posts</a></li>
    <li><span aria-current="page" lang={lang}>{title}</span></li>
  </ol>
</nav>

<style>
  ol {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 0.8rem;
    font-weight: 750;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  li + li::before {
    margin-right: 0.5rem;
    color: var(--accent-text);
    content: '/';
  }
  a {
    text-decoration: none;
    border-bottom: 2px solid currentColor;
  }
  a:hover {
    color: var(--accent-text);
  }
  [aria-current] {
    display: inline-block;
    max-width: 28ch;
    overflow: hidden;
    color: var(--ink-muted);
    text-overflow: ellipsis;
    white-space: nowrap;
    vertical-align: bottom;
  }
</style>
