---
import { drawInlinePattern } from '@/features/posts/inline-pattern';
import { parsePostId } from '@/features/posts/id';
import { formatDate, formatInstant } from '@/utils/date';
import { japanesePhrases } from '@/utils/phrases';

interface Props {
  /** The post's id, which picks and seeds its picture. */
  postId: string;
  title: string;
  description: string;
  publishedAt: Date;
  tags: string[];
}

const { postId, title, description, publishedAt, tags } = Astro.props;

// The pattern the post's Open Graph card draws from the same seed, in the
// page's colors.
const patternSvg = drawInlinePattern(postId);

// A Japanese title breaks only between phrases, so a word or a name is never
// cut across lines; other languages break at spaces as usual. The summary is
// running text and breaks as text does: by phrase, a long phrase would leave
// a short line with room to spare.
const titlePhrases = parsePostId(postId).lang === 'ja' ? japanesePhrases(title) : [title];
---

{/*
  Text first: the title and the summary carry the head. The picture is
  supplementary, so on wide screens it takes the columns the notes use below.
*/}
<header>
  <h1>{titlePhrases.map((phrase, i) => (i === 0 ? phrase : [<wbr />, phrase]))}</h1>
  <p class="description">{description}</p>
  <div class="art" aria-hidden="true" set:html={patternSvg} />
  <div class="meta">
    {/* The date is English UI text, even inside a Japanese post. */}
    <time datetime={formatInstant(publishedAt)} lang="en">
      {formatDate(publishedAt)}
    </time>
    {tags.length > 0 && (
      <ul class="tags" aria-label="Tags">
        {tags.map((tag) => (
          <li>{tag}</li>
        ))}
      </ul>
    )}
  </div>
</header>

<style>
  /* Narrow screens stack the head, with a small picture beside the summary. */
  header {
    /* Below the title's accent bar, as below each section's (prose.css). */
    --bar-gap: 1.25rem;
    display: grid;
    grid-template-columns: minmax(0, 1fr) 6rem;
    column-gap: 1rem;
    row-gap: 1.5rem;
  }
  /* Article titles are sentences: big, but not set as poster capitals. */
  h1 {
    grid-column: 1 / -1;
    margin: 0;
    font-size: clamp(2.25rem, 5vw, 4.25rem);
    font-weight: 800;
    line-height: 1.02;
    letter-spacing: -0.045em;
    text-wrap: balance;
  }
  /*
   * Japanese display type sets proportional widths (palt): kana and brackets
   * lose the side room a square body gives them, so `（` no longer opens a gap
   * and the title holds together as Latin does at -0.045em. Only the title:
   * running text reads better on the even square.
   */
  h1:lang(ja) {
    font-size: clamp(2rem, 4vw, 3.25rem);
    line-height: 1.3;
    letter-spacing: 0;
    font-feature-settings: 'palt';
  }
  /*
   * The accent bar that opens the article, set as each section's h2 sets it
   * (prose.css): the same bar, the same gap below, so the two read as one mark.
   */
  h1::before {
    display: block;
    width: 3rem;
    height: var(--rule-heavy);
    margin-bottom: var(--bar-gap);
    background: var(--accent);
    content: '';
  }
  /*
   * A Japanese title breaks only at the `<wbr>` between phrases. A phrase too
   * long for its line, on a narrow screen, may still break inside rather than
   * overflow.
   */
  h1:lang(ja) {
    word-break: keep-all;
    overflow-wrap: anywhere;
  }
  /*
   * The summary is the standfirst: larger than the text, well below the title.
   * Kana and kanji fill their square and set denser than Latin, so Japanese
   * at the same size reads much louder; it takes about 0.8 of the Latin size.
   */
  .description {
    max-width: 28em;
    margin: 0;
    font-size: clamp(1.1875rem, 1.9vw, 1.75rem);
    line-height: 1.4;
    letter-spacing: -0.01em;
    text-wrap: pretty;
  }
  /* Strict line breaking, as in the text: no small kana or long vowel mark opens a line. */
  .description:lang(ja) {
    font-size: clamp(1.0625rem, 1.5vw, 1.375rem);
    line-height: 1.8;
    letter-spacing: 0.02em;
    line-break: strict;
  }
  .art {
    align-self: start;
    border-top: 2px solid var(--ink);
  }
  .art :global(svg) {
    display: block;
    width: 100%;
    height: auto;
  }
  .meta {
    grid-column: 1 / -1;
    display: grid;
    gap: 0.625rem;
    padding-top: 0.875rem;
    border-top: 2px solid var(--ink);
  }
  time {
    font-size: 0.8rem;
    font-weight: 750;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    font-variant-numeric: tabular-nums;
  }
  /*
   * Tags keep their own case, since many are product names, and are parted by
   * accent slashes as in the breadcrumbs. Plain text until tags have pages.
   */
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--ink-muted);
  }
  /* The slash ends a tag rather than starts one, so a wrapped line never opens on it. */
  .tags li:not(:last-child)::after {
    margin-left: 0.5rem;
    color: var(--accent-text);
    content: '/' / '';
  }

  /*
   * Wide screens put the head on the page's 12 columns, as the text below:
   * the date and the tags in columns 1 to 3 beside the title, where the
   * contents run below; the title and the summary from column 4, over the
   * text; and the picture in columns 11 and 12, where the notes go.
   */
  @media (min-width: 75rem) {
    header {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: 0;
      row-gap: 2.5rem;
    }
    h1 {
      grid-column: 4 / 13;
    }
    /*
     * Level with the title's text, below its bar, and kept 2rem clear of it as
     * the contents are of the text.
     */
    .meta {
      grid-column: 1 / 4;
      grid-row: 1 / 3;
      align-self: start;
      margin-top: calc(var(--rule-heavy) + var(--bar-gap));
      margin-right: 2rem;
    }
    /*
     * No gap of its own on the right: the picture keeps 2rem clear, and a
     * padding would come out of the 28em measure, breaking lines short.
     */
    .description {
      grid-column: 4 / 11;
    }
    .art {
      grid-column: 11 / 13;
      grid-row: 2;
      margin-top: 0.5rem;
      margin-left: 2rem;
    }
  }
</style>
