---
import { AUTHOR } from '@/site';

// The monogram stands in for a photo: the name's first letter on a solid.
const monogram = AUTHOR.name.charAt(0).toUpperCase();
---

{/* UI text is English, even on a Japanese page. */}
<section aria-labelledby="author-name" lang="en">
  <div class="monogram" aria-hidden="true">
    {monogram}
  </div>
  <div>
    <p class="label">Written by</p>
    <h2 id="author-name">{AUTHOR.name}</h2>
    <p class="bio">{AUTHOR.bio}</p>
  </div>
</section>

<style>
  section {
    display: grid;
    grid-template-columns: 4.5rem minmax(0, 1fr);
    gap: 1rem;
    padding-top: 1.25rem;
    border-top: var(--rule-heavy) solid var(--ink);
  }
  .monogram {
    display: grid;
    place-items: center;
    align-self: start;
    aspect-ratio: 1;
    color: var(--on-solid);
    background: var(--solid);
    font-size: 2rem;
    font-weight: 860;
    letter-spacing: -0.06em;
  }
  .label {
    margin: 0;
    font-size: 0.8rem;
    font-weight: 750;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-muted);
  }
  h2 {
    margin: 0.25rem 0 0.375rem;
    font-size: 1.5rem;
    font-weight: 840;
    line-height: 1.2;
    letter-spacing: -0.04em;
  }
  .bio {
    margin: 0;
    font-size: 1rem;
    line-height: 1.6;
  }
  @media (min-width: 40rem) {
    section {
      grid-template-columns: 5.5rem minmax(0, 1fr);
      gap: 1.5rem;
    }
    .monogram {
      font-size: 2.5rem;
    }
  }
</style>
