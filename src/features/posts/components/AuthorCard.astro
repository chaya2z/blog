---
import { getImage } from 'astro:assets';
import githubBlack from '@/assets/icons/github-black.png';
import githubWhite from '@/assets/icons/github-white.png';
import LanguageIcon from '@/assets/icons/language.svg';
import linkedinBlack from '@/assets/icons/linkedin-black.png';
import linkedinWhite from '@/assets/icons/linkedin-white.png';
import { AUTHOR } from '@/site';

// The monogram stands in for a photo: the name's first letter on a solid.
const monogram = AUTHOR.name.charAt(0).toUpperCase();

/*
 * The links sit beside the name, small and unframed, so they read as part of
 * the byline. Logos are the brands' own files, unaltered, in black or white
 * per theme; they share a height and keep their own widths.
 */
const LOGO_HEIGHT = 18;

// UI icons are Material Symbols, drawn at the logos' height.
const ICON_SIZE = 20;

const logoAt = (src: ImageMetadata) => getImage({ src, height: LOGO_HEIGHT, densities: [1, 2] });
const [githubLight, githubDark, linkedinLight, linkedinDark] = await Promise.all(
  [githubBlack, githubWhite, linkedinBlack, linkedinWhite].map(logoAt),
);

const logos = [
  { href: AUTHOR.links.github, label: 'GitHub', light: githubLight, dark: githubDark },
  { href: AUTHOR.links.linkedin, label: 'LinkedIn', light: linkedinLight, dark: linkedinDark },
];
---

{/* UI text is English, even on a Japanese page. */}
<section aria-labelledby="author-name" lang="en">
  <div class="monogram" aria-hidden="true">
    {monogram}
  </div>
  <div class="byline">
    <p class="label">Written by</p>
    <h2 id="author-name">{AUTHOR.name}</h2>
    {/* The handle leads the links, so the marks follow a word, not open space. */}
    <div class="handle-row">
      <p class="handle">@{AUTHOR.handle}</p>
      <ul aria-label={`${AUTHOR.name} elsewhere`}>
        {logos.map((logo) => (
          <li>
            <a href={logo.href} aria-label={`${AUTHOR.name} on ${logo.label}`}>
              <picture>
                <source media="(prefers-color-scheme: dark)" srcset={logo.dark.srcSet.attribute} />
                <img
                  class="logo"
                  src={logo.light.src}
                  srcset={logo.light.srcSet.attribute}
                  {...logo.light.attributes}
                  alt=""
                />
              </picture>
            </a>
          </li>
        ))}
        <li>
          <a href={AUTHOR.links.website} aria-label="chaya2z.com">
            <LanguageIcon
              class="icon"
              width={ICON_SIZE}
              height={ICON_SIZE}
              fill="currentColor"
              aria-hidden="true"
            />
          </a>
        </li>
      </ul>
    </div>
  </div>
</section>

<style>
  section {
    display: grid;
    grid-template-columns: 5.5rem minmax(0, 1fr);
    gap: 1rem;
    padding-top: 1.25rem;
    border-top: var(--rule-heavy) solid var(--ink);
  }
  .monogram {
    display: grid;
    place-items: center;
    align-self: start;
    aspect-ratio: 1;
    color: var(--on-solid);
    background: var(--solid);
    font-size: 2.5rem;
    font-weight: 860;
    letter-spacing: -0.06em;
  }
  /*
   * The byline stretches to the monogram's height and spreads its lines over
   * it, so the label starts level with the monogram's top and the handle ends
   * level with its bottom.
   */
  .byline {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }
  .label {
    margin: 0;
    font-size: 0.8rem;
    font-weight: 750;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-muted);
  }
  h2 {
    margin: 0;
    font-size: 1.5rem;
    font-weight: 840;
    line-height: 1.2;
    letter-spacing: -0.02em;
  }
  .handle-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0 0.5rem;
  }
  .handle {
    margin: 0;
    color: var(--ink-muted);
    font-size: 1rem;
    font-weight: 600;
  }
  /*
   * A hairline after the handle joins the marks to it, so they read as one
   * byline rather than loose over the grid. The targets overhang the handle's
   * line instead of making it taller.
   */
  ul {
    display: flex;
    align-items: center;
    margin: -0.5rem 0;
    padding: 0;
    list-style: none;
  }
  ul::before {
    height: 1.1rem;
    margin-right: 0.25rem;
    border-left: 1px solid var(--ink-hairline);
    content: '';
  }
  /*
   * Narrower than the share links' 44px squares, to keep the marks close; the
   * targets still clear the 24px minimum.
   * ref: https://www.w3.org/WAI/WCAG22/Understanding/target-size-minimum.html
   */
  a {
    position: relative;
    display: inline-grid;
    place-items: center;
    width: 1.75rem;
    height: 2.75rem;
  }
  /*
   * Pointing at a mark, or focusing it, draws a short rule under it, inside
   * the handle's line, so nothing lands on the name. The rule replaces the
   * global focus ring, which would. The logo stays unaltered.
   */
  a::after {
    position: absolute;
    top: calc(50% + 0.75rem);
    left: 0.375rem;
    right: 0.375rem;
    height: 2px;
    background: currentColor;
    content: '';
    opacity: 0;
  }
  a:focus-visible {
    outline: none;
  }
  a:hover::after,
  a:focus-visible::after {
    opacity: 1;
  }
  @media (prefers-reduced-motion: no-preference) {
    a::after {
      transition: opacity 0.2s ease-out;
    }
  }
  /* Undo the global `height: auto`, which would size logos from their files. */
  .logo {
    display: block;
    height: 18px;
    width: auto;
  }
  .icon {
    display: block;
    width: 20px;
    height: 20px;
  }
  @media (min-width: 40rem) {
    section {
      gap: 1.5rem;
    }
  }
</style>
