---
import { drawInlinePattern } from '@/features/posts/inline-pattern';
import type { PostEntry } from '@/features/posts/content';
import { parsePostId } from '@/features/posts/id';
import { getPostPath } from '@/features/posts/routing';
import { formatDate } from '@/utils/date';
import { japanesePhrases } from '@/utils/phrases';

interface Props {
  posts: PostEntry[];
}

const { posts } = Astro.props;

// A Japanese title breaks only between phrases, as the post's own title does.
const titlePhrases = (post: PostEntry) =>
  parsePostId(post.id).lang === 'ja' ? japanesePhrases(post.data.title) : [post.data.title];
---

{posts.length > 0 && (
  // UI text is English, even on a Japanese page; each title keeps its own language.
  <section aria-labelledby="related-label" lang="en">
    <h2 id="related-label">Related</h2>
    <ul>
      {posts.map((post) => (
        <li>
          {/* Each post shows the picture of its card, cropped to the tile. */}
          <a href={getPostPath(post.id)}>
            <div
              class="art"
              aria-hidden="true"
              set:html={drawInlinePattern(post.id, { crop: true })}
            />
            <span class="title" lang={parsePostId(post.id).lang}>
              {titlePhrases(post).map((phrase, i) => (i === 0 ? phrase : [<wbr />, phrase]))}
            </span>
            <time datetime={post.data.publishedAt.toISOString()}>
              {formatDate(post.data.publishedAt)}
            </time>
          </a>
        </li>
      ))}
    </ul>
  </section>
)}

<style>
  section {
    padding-top: 0.75rem;
    border-top: 2px solid var(--ink);
  }
  h2 {
    margin: 0 0 1rem;
    font-size: 0.8rem;
    font-weight: 750;
    line-height: 1.5;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  ul {
    display: grid;
    gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  /* Narrow screens list the posts as rows, the picture a small tile at the left. */
  a {
    display: grid;
    grid-template-columns: 5rem minmax(0, 1fr);
    grid-template-rows: auto 1fr;
    column-gap: 1rem;
    row-gap: 0.375rem;
    text-decoration: none;
  }
  .art {
    grid-row: 1 / 3;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border-top: 2px solid var(--ink);
  }
  .art :global(svg) {
    display: block;
    width: 100%;
    height: 100%;
  }
  .title {
    font-size: 1rem;
    font-weight: 750;
    line-height: 1.35;
    text-wrap: pretty;
  }
  /*
   * As the post's own title: breaks only at the `<wbr>` between phrases, or
   * inside one too long for its line, and proportional widths.
   */
  .title:lang(ja) {
    word-break: keep-all;
    overflow-wrap: anywhere;
    font-feature-settings: 'palt';
  }
  a:hover .title {
    color: var(--accent-text);
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.2em;
  }
  time {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    font-variant-numeric: tabular-nums;
    color: var(--ink-muted);
  }

  /* Wider screens set them side by side, each picture across the top of its post. */
  @media (min-width: 40rem) {
    ul {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 1.5rem;
    }
    a {
      grid-template-columns: minmax(0, 1fr);
      grid-template-rows: auto;
      row-gap: 0.5rem;
    }
    .art {
      grid-row: auto;
      margin-bottom: 0.25rem;
    }
  }
</style>
