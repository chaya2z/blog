---
import type { PostEntry } from '../content';
import { formatDate } from '../date';
import { parsePostId } from '../id';
import { getPostPath } from '../routing';

interface Props {
  posts: PostEntry[];
}

const { posts } = Astro.props;
---

<ul>
  {posts.map((post) => (
    <li>
      <article lang={parsePostId(post.id).lang}>
        {/* The date is English UI text, even beside a Japanese title. */}
        <time datetime={post.data.publishedAt.toISOString().slice(0, 10)} lang="en">
          {formatDate(post.data.publishedAt)}
        </time>
        <h2>
          <a href={getPostPath(post.id)}>{post.data.title}</a>
        </h2>
      </article>
    </li>
  ))}
</ul>

<style>
  ul {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: var(--rule-heavy) solid var(--ink);
  }
  li {
    border-bottom: 2px solid var(--ink);
  }
  /*
   * The date takes one and a half of the page's twelve columns, so the title
   * starts midway through the second. Stacked when that cannot hold the date.
   */
  article {
    display: grid;
    grid-template-columns: calc(100cqi / 12 * 1.5) minmax(0, 1fr);
    align-items: center;
    /* Sized with the title so at least seven posts fit on a 1280x800 screen. */
    padding-block: clamp(1.25rem, 2vw, 2rem);
  }
  time {
    font-size: 0.85rem;
    /* Lighter than the title (700), so the title leads. */
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    font-variant-numeric: tabular-nums;
  }
  h2 {
    /*
     * About 28 Japanese or 64 Latin characters, near the 66 Bringhurst gives
     * for body text. In em, not ch, so it does not depend on the font.
     */
    max-width: 28em;
    margin: 0;
    /*
     * Below about 340px the column is too narrow for 22px, so the size
     * follows it to keep titles within two lines. 6.5cqi was measured against
     * the current titles, not guaranteed.
     */
    --title-size: min(clamp(1.375rem, 2vw, 1.75rem), 6.5cqi);
    font-size: var(--title-size);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }
  h2:lang(ja) {
    /* Kana and kanji look larger than Latin at the same size; Stripe's ratio. */
    font-size: calc(var(--title-size) * 0.92);
    /* Kanji ink is 0.92em tall, Latin capitals 0.73em: same gap as Latin at 1. */
    line-height: 1.2;
    letter-spacing: 0;
    /* Break between phrases, not inside words (where supported). */
    word-break: auto-phrase;
  }
  a {
    text-decoration: none;
  }
  a:hover {
    color: var(--accent-text);
  }
  /* The widest date (6.35rem) plus a 1rem gap, times eight (12 / 1.5). */
  @container (width < 58.8rem) {
    article {
      grid-template-columns: 1fr;
      row-gap: 0.75rem;
    }
  }
</style>
