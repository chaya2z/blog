---
import PostList from '../features/posts/components/PostList.astro';
import { getPosts } from '../features/posts/content';
import BaseLayout from '../shared/layouts/BaseLayout.astro';

const posts = (await getPosts()).slice(0, 5);
---

<BaseLayout title="Abyssal Tarantella" lang="en">
  <section class="container latest" aria-labelledby="latest">
    <div class="head">
      {/* The page's only heading above the post titles, so the outline stays h1 > h2. */}
      <h1 id="latest" class="title">
        <span class="num">01</span> Latest posts
      </h1>
      <a href="/posts/" class="more">All posts <span aria-hidden="true">→</span></a>
    </div>
    <PostList posts={posts} />
  </section>
</BaseLayout>

<style>
  /*
   * The top page prints its second ink in red instead of petrol blue.
   * Its paper and ink match global.css, so only the accent changes. `html`
   * outranks global.css, which may load after this page's styles.
   */
  :global(html:root) {
    --accent: #b8281d;
    --accent-text: #a32219;
  }
  @media (prefers-color-scheme: dark) {
    :global(html:root) {
      --accent: #c2302a;
      --accent-text: #ff9384;
    }
  }
  .latest {
    padding-block: clamp(2.5rem, 5vw, 4.5rem);
  }
  /*
   * A heavy and a thin rule, a hairline numeral that breaks through the top
   * rule, and the name set in wide-tracked capitals.
   */
  .head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-end;
    gap: 0.75rem 1.5rem;
    margin-bottom: clamp(2rem, 4vw, 3.5rem);
    padding-block: 1rem;
    border-top: var(--rule-heavy) solid currentColor;
    border-bottom: 2px solid currentColor;
  }
  .title {
    display: flex;
    align-items: flex-end;
    gap: 1rem;
    margin: 0;
    font-size: 0.95rem;
    font-weight: 800;
    line-height: 1.2;
    letter-spacing: 0.32em;
    text-transform: uppercase;
  }
  .num {
    /* Sits on the paper, so it blocks the rule where it crosses it. */
    margin-block: calc(-0.55em - 1rem) -0.12em;
    padding-inline: 0 0.12em;
    color: var(--accent-text);
    background: var(--paper);
    font-size: clamp(3.5rem, 7vw, 6rem);
    font-weight: 250;
    line-height: 0.8;
    letter-spacing: -0.06em;
    font-variant-numeric: tabular-nums;
  }
  .more {
    font-size: 0.9rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-decoration: none;
    border-bottom: 3px solid currentColor;
  }
  .more:hover {
    color: var(--accent-text);
  }
  /* The heading already draws the heavy rule. */
  .latest > :global(ul) {
    border-top: 0;
  }
</style>
