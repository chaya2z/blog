---
import Masthead from '@/components/Masthead.astro';
import PostList from '@/features/posts/components/PostList.astro';
import { ogImagePath } from '@/features/og-image/image';
import { getPosts } from '@/features/posts/content';
import SiteLayout from '@/layouts/SiteLayout.astro';
import { POSTS_TAGLINE, SITE_DESCRIPTION, SITE_TITLE } from '@/site';

const posts = await getPosts();
// The card shows the page's name and the kinds of posts, under the site's name.
const ogImage = { path: ogImagePath('posts'), alt: `Posts on ${SITE_TITLE}: ${POSTS_TAGLINE}` };
---

<SiteLayout title="Posts" lang="en" description={SITE_DESCRIPTION} {ogImage}>
  <Masthead title="Posts" />
  <div class="container list">
    <PostList posts={posts} />
  </div>
</SiteLayout>

<style>
  .list {
    padding-block: clamp(2.5rem, 5vw, 4.5rem);
  }
</style>
