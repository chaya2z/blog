---
import { getEntry, render } from 'astro:content';
import Masthead from '@/components/Masthead.astro';
import { formatDate } from '@/utils/date';
import BaseLayout from '@/layouts/BaseLayout.astro';
import '@/styles/prose.css';

const page = await getEntry('pages', 'privacy');
if (!page) {
  throw new Error('Missing src/content/pages/privacy.md');
}
const { Content } = await render(page);
const { title, updatedAt } = page.data;
---

{/* English only, like the rest of the UI. */}
<BaseLayout title={title} lang="en">
  <Masthead title="Privacy" />
  <div class="container body">
    <p class="updated">
      Last updated:{' '}
      <time datetime={updatedAt.toISOString().slice(0, 10)}>{formatDate(updatedAt)}</time>
    </p>
    <div class="prose">
      <Content />
    </div>
  </div>
</BaseLayout>

<style>
  .body {
    padding-block: clamp(2.5rem, 5vw, 4.5rem);
  }
  .updated {
    margin: 0 0 2rem;
    color: var(--ink-muted);
  }
  .prose {
    max-width: 68ch;
  }
</style>
