---
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';
import 'katex/dist/katex.min.css';
import JsonLd from '@/components/JsonLd.astro';
import ArticleHeader from '@/features/posts/components/ArticleHeader.astro';
import AuthorCard from '@/features/posts/components/AuthorCard.astro';
import Breadcrumbs from '@/features/posts/components/Breadcrumbs.astro';
import RelatedPosts from '@/features/posts/components/RelatedPosts.astro';
import ShareLinks from '@/features/posts/components/ShareLinks.astro';
import TableOfContents from '@/features/posts/components/TableOfContents.astro';
import { postOgImagePath } from '@/features/og-image/image';
import { getPosts, type PostEntry } from '@/features/posts/content';
import { parsePostId } from '@/features/posts/id';
import { relatedPosts } from '@/features/posts/related';
import { postBreadcrumbJsonLd, postJsonLd } from '@/features/posts/structured-data';
import '@/styles/prose.css';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { SITE_TITLE } from '@/site';
import { formatDate } from '@/utils/date';

export const getStaticPaths = (async () => {
  const posts = await getPosts();
  return posts.map((post) => ({
    params: parsePostId(post.id),
    props: { post, related: relatedPosts(post, posts) },
  }));
}) satisfies GetStaticPaths;

interface Props {
  post: PostEntry;
  /** Posts sharing its tags, most alike first. */
  related: PostEntry[];
}

const { post, related } = Astro.props;
const { lang } = parsePostId(post.id);
const { Content, headings } = await render(post);
const url = new URL(Astro.url.pathname, Astro.site).href;
// The post's card shows its title, the site's name and the date.
const ogImage = {
  path: postOgImagePath(post.id),
  alt: `${post.data.title} on ${SITE_TITLE}, ${formatDate(post.data.publishedAt)}`,
};
const blogPosting = postJsonLd({
  title: post.data.title,
  description: post.data.description,
  lang,
  tags: post.data.tags,
  imageUrl: new URL(ogImage.path, Astro.site).href,
  publishedAt: post.data.publishedAt,
  updatedAt: post.data.updatedAt,
});
const breadcrumbList = postBreadcrumbJsonLd({ title: post.data.title, siteUrl: Astro.site! });
---

<BaseLayout
  title={post.data.title}
  lang={lang}
  description={post.data.description}
  article={{ publishedTime: post.data.publishedAt, modifiedTime: post.data.updatedAt }}
  {ogImage}
>
  <JsonLd slot="head" data={blogPosting} />
  <JsonLd slot="head" data={breadcrumbList} />
  {/* Breadcrumbs are site navigation, so they stay outside the article. */}
  <div class="container crumbs">
    <Breadcrumbs title={post.data.title} lang={lang} />
  </div>
  <article>
    <div class="article-head">
      <div class="container">
        <ArticleHeader
          postId={post.id}
          title={post.data.title}
          description={post.data.description}
          publishedAt={post.data.publishedAt}
          tags={post.data.tags}
        />
      </div>
    </div>
    <div class="container body">
      <div class="prose">
        <Content />
      </div>
      {/* After the text in source order; wide screens move it to a side rail. */}
      <div class="rail">
        <div class="rail-inner">
          <TableOfContents {headings} {lang} />
          <div class="share">
            {/* The list is named for screen readers already; this is its visible label. */}
            <p class="share-label" lang="en" aria-hidden="true">
              Share
            </p>
            <ShareLinks url={url} title={post.data.title} />
          </div>
        </div>
      </div>
      <div class="end">
        <AuthorCard />
      </div>
    </div>
  </article>
  {/* Other posts are site navigation, so they follow the article rather than join it. */}
  {related.length > 0 && (
    <div class="container more">
      <div class="more-inner">
        <RelatedPosts posts={related} />
      </div>
    </div>
  )}
</BaseLayout>

<script>
  /*
   * On wide screens the notes take no height (see the style below), so a long
   * one could run into the next block's notes, or past the end of the text.
   * Each block's notes start no higher than a gap below the end of the notes
   * before them, and the text ends no higher than the last notes. Without this
   * script the notes keep their height and hold the next block down instead.
   */
  const WIDE = window.matchMedia('(min-width: 88rem)');
  const prose = document.querySelector<HTMLElement>('.prose');
  const groups = [...document.querySelectorAll<HTMLElement>('.prose .sidenotes')];

  const placeNotes = (text: HTMLElement) => {
    text.style.paddingBottom = '';
    let end = -Infinity;
    for (const group of groups) {
      group.style.translate = '';
      if (!WIDE.matches) continue;
      const top = group.getBoundingClientRect().top + window.scrollY;
      const shift = Math.max(0, end + parseFloat(getComputedStyle(group).rowGap) - top);
      if (shift > 0) group.style.translate = `0 ${shift}px`;
      end = top + shift + group.scrollHeight;
    }
    const overrun = end - (text.getBoundingClientRect().bottom + window.scrollY);
    if (overrun > 0) text.style.paddingBottom = `${overrun}px`;
  };

  if (prose && groups.length > 0) {
    prose.dataset.sidenotesPlaced = '';
    // The text's size changes with the window and as its fonts load.
    new ResizeObserver(() => placeNotes(prose)).observe(prose);
    WIDE.addEventListener('change', () => placeNotes(prose));
  }
</script>
<style>
  .article-head {
    padding-block: 1.5rem clamp(2.5rem, 5vw, 5rem);
    border-bottom: var(--rule-heavy) solid var(--ink);
  }
  .crumbs {
    padding-top: clamp(1.5rem, 4vw, 3rem);
  }
  .body {
    padding-block: clamp(2.5rem, 5vw, 4.5rem);
  }
  /* About 68 characters, near the 66 Bringhurst gives for body text. */
  .prose {
    max-width: 68ch;
  }
  .rail {
    margin-top: clamp(2.5rem, 5vw, 4.5rem);
  }
  /* Narrow screens read straight through: no contents, the share links after the text. */
  .rail :global([data-toc]) {
    display: none;
  }
  .share {
    padding-top: 0.75rem;
    border-top: 2px solid var(--ink);
    /* The share links set themselves two by two when queried against this width. */
    container-type: inline-size;
  }
  /* What closes the article, and the posts after it, over the text's width. */
  .end,
  .more-inner {
    max-width: 68ch;
    /* The text's size (prose.css), so that 68ch is the text's width. */
    font-size: 1.125rem;
  }
  .end {
    margin-top: clamp(3.5rem, 7vw, 6rem);
  }
  .more {
    padding-bottom: clamp(3rem, 6vw, 5rem);
  }
  .share-label {
    margin: 0 0 0.75rem;
    font-size: 0.8rem;
    font-weight: 750;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  /*
   * Wide screens sit on the 12-column grid drawn behind the page: the contents
   * and the share links follow the reader down columns 1 to 3, and the text
   * starts at column 4. Its 68 characters fit in columns 4 to 11 from 75rem.
   *
   * The rail keeps 2rem clear of the text, about one line of it: less than the
   * gap between paragraphs, and the contents read as part of the text. Three
   * columns leave the contents about 15rem, so most titles take one line.
   */
  @media (min-width: 75rem) {
    .body {
      display: grid;
      grid-template-columns: repeat(12, minmax(0, 1fr));
    }
    .prose {
      grid-column: 4 / 12;
      grid-row: 1;
    }
    .end {
      grid-column: 4 / 12;
      grid-row: 2;
    }
    .more {
      display: grid;
      grid-template-columns: repeat(12, minmax(0, 1fr));
    }
    .more-inner {
      grid-column: 4 / 12;
    }
    /* Spans the text's full height, so the inner block can stick within it. */
    .rail {
      grid-column: 1 / 4;
      grid-row: 1;
      margin-top: 0;
      padding-right: 2rem;
    }
    .rail-inner {
      position: sticky;
      top: 2rem;
      display: grid;
      gap: 2.5rem;
    }
    .rail :global([data-toc]) {
      display: block;
    }
  }

  /*
   * Once the page reaches its full 84rem, about 13rem is free to the right of
   * the 68 characters, and a block's notes (plugins/sidenotes.ts) move there,
   * level with it. Narrower pages leave too little, so the notes stay under
   * their block until the window is 88rem, the page and its side gutters.
   *
   * The block and its notes share a grid that reaches from the text's left edge
   * to the page's, 9 columns: the text's 68 characters, a gutter, and the notes
   * in what is left. A note longer than its block holds the next block down,
   * until the script above places the notes: then they take no height, so the
   * row is the block's, a long note runs on down the margin, and the text
   * below keeps its place.
   *
   * A long note shows whole here, open or not, with its number at its start.
   */
  @media (min-width: 88rem) {
    .prose :global(.noted) {
      display: grid;
      grid-template-columns: 68ch minmax(0, 1fr);
      column-gap: 2rem;
      align-items: start;
      width: calc(100cqi / 12 * 9);
    }
    .prose :global(.sidenotes) {
      margin-top: 0.25rem;
    }
    .prose[data-sidenotes-placed] :global(.sidenotes) {
      height: 0;
    }
  }
  /* A browser that cannot show a closed note's blocks keeps it folded. */
  @media (min-width: 88rem) {
    @supports selector(::details-content) {
      .prose :global(.sidenote details::details-content) {
        content-visibility: visible;
      }
      .prose :global(.sidenote summary) {
        display: block;
        float: left;
        margin-right: 0.3em;
        overflow: visible;
        cursor: auto;
        -webkit-line-clamp: none;
        line-clamp: none;
      }
      .prose :global(.sidenote summary::before),
      .prose :global(.sidenote-excerpt) {
        display: none;
      }
    }
  }
</style>
