---
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';
import 'katex/dist/katex.min.css';
import ArticleHeader from '@/features/posts/components/ArticleHeader.astro';
import Breadcrumbs from '@/features/posts/components/Breadcrumbs.astro';
import ShareLinks from '@/features/posts/components/ShareLinks.astro';
import { getPosts, type PostEntry } from '@/features/posts/content';
import { parsePostId } from '@/features/posts/id';
import '@/styles/prose.css';
import BaseLayout from '@/layouts/BaseLayout.astro';

export const getStaticPaths = (async () => {
  const posts = await getPosts();
  return posts.map((post) => ({
    params: parsePostId(post.id),
    props: { post },
  }));
}) satisfies GetStaticPaths;

interface Props {
  post: PostEntry;
}

const { post } = Astro.props;
const { lang } = parsePostId(post.id);
const { Content } = await render(post);
const url = new URL(Astro.url.pathname, Astro.site).href;
---

<BaseLayout
  title={post.data.title}
  lang={lang}
  description={post.data.description}
  article={{ publishedTime: post.data.publishedAt }}
>
  {/* Breadcrumbs are site navigation, so they stay outside the article. */}
  <div class="container crumbs">
    <Breadcrumbs title={post.data.title} lang={lang} />
  </div>
  <article>
    <div class="article-head">
      <div class="container">
        <ArticleHeader title={post.data.title} publishedAt={post.data.publishedAt} />
      </div>
    </div>
    <div class="container body">
      <div class="prose">
        <Content />
      </div>
      {/* After the text in source order; wide screens move it to a side rail. */}
      <div class="share">
        <div class="share-inner">
          <ShareLinks url={url} title={post.data.title} />
        </div>
      </div>
    </div>
  </article>
</BaseLayout>

<style>
  .article-head {
    padding-block: 1.5rem clamp(2.5rem, 5vw, 4.5rem);
    border-bottom: var(--rule-heavy) solid var(--ink);
  }
  .crumbs {
    padding-top: clamp(1.5rem, 4vw, 3rem);
  }
  .body {
    padding-block: clamp(2.5rem, 5vw, 4.5rem);
  }
  .prose {
    max-width: 68ch;
  }
  .share {
    margin-top: clamp(2.5rem, 5vw, 4.5rem);
    /* The share links stack into a column when queried against this width. */
    container-type: inline-size;
  }

  /*
   * Wide screens sit on the 12-column grid drawn behind the page: share links
   * follow the reader down column 1, and the text runs from column 2 to 9,
   * leaving 10 to 12 for a table of contents. From 75rem, column 1 is about
   * 5.9rem wide, so the 2.75rem buttons keep about 3.2rem clear of the text.
   */
  @media (min-width: 75rem) {
    .body {
      display: grid;
      grid-template-columns: repeat(12, minmax(0, 1fr));
    }
    .prose {
      grid-column: 2 / 10;
      grid-row: 1;
    }
    /* Spans the text's full height, so the inner block can stick within it. */
    .share {
      grid-column: 1;
      grid-row: 1;
      margin-top: 0;
    }
    .share-inner {
      position: sticky;
      top: 2rem;
    }
  }
</style>
