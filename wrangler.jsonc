{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "blog",
  "compatibility_date": "2026-10-12",
  "assets": {
    "directory": "./dist"
  },
  // Serve only on the custom domain; the workers.dev hostnames stay off.
  "routes": [
    {
      "pattern": "blog.chaya2z.com",
      "custom_domain": true
    }
  ],
  "workers_dev": false,
  "preview_urls": false,
  "previews": {}
}
